{
  "name": "buraq",
  "version": "0.1.0",
  "description": "Header-only, zero-dependency C++20/23 SDK for the Agent Client Protocol (ACP) v1",
  "homepage": "https://github.com/khubaibumer/buraq",
  "license": "Apache-2.0",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "glaze": {
      "description": "Glaze JSON codec (buraq/codecs/glaze.hpp)",
      "dependencies": [
        "glaze"
      ]
    },
    "nlohmann-json": {
      "description": "nlohmann/json codec (buraq/codecs/nlohmann.hpp)",
      "dependencies": [
        "nlohmann-json"
      ]
    }
  }
}
